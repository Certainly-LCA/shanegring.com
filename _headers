# Cloudflare Pages headers.
#
# Keep the Pages-hosted copies out of search. The canonical host is
# shanegring.com; shanegring-com.pages.dev serves the identical site, so without
# this it is a full duplicate competing with the canonical domain. Rules are
# scoped by full URL so the canonical host is untouched.
#
# This complements the hostname guard on the GTM snippet in every page's <head>
# (which keeps preview traffic out of GA4). That guard handles analytics; this
# handles indexing. They are separate problems and need separate fixes.

https://shanegring-com.pages.dev/*
  X-Robots-Tag: noindex

https://:version.shanegring-com.pages.dev/*
  X-Robots-Tag: noindex

# Pages serves static assets with a four-hour cache by default, and the
# stylesheet and scripts are referenced without a version in the URL. Pages
# themselves revalidate every request, so a returning visitor could hold new
# HTML against a stylesheet up to four hours old. That desync is not
# theoretical: it put an off-screen honeypot field on screen as an empty box
# in the middle of the signup form. Short cache plus revalidation closes the
# window; these files are small enough that the cost is a conditional request.
/styles.css
  Cache-Control: public, max-age=60, must-revalidate

/nav.js
  Cache-Control: public, max-age=60, must-revalidate

/track.js
  Cache-Control: public, max-age=60, must-revalidate

/subscribe.js
  Cache-Control: public, max-age=60, must-revalidate
